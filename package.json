{
  "name": "coding-agent",
  "version": "0.0.1",
  "description": "Coding Agent CLI — natural-language coding tasks over a real codebase",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "openai": "^7.1.0",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2"
  }
}
