{
  "name": "coding-agent",
  "version": "0.0.1",
  "description": "Coding Agent CLI — natural-language coding tasks over a real codebase",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "build": "bun run --filter '@coding-agent/*' build",
    "example:ai": "bun run packages/ai/examples/stream.ts",
    "check": "biome check .",
    "ci:check": "biome ci .",
    "check:import-boundaries": "bun run scripts/check-import-boundaries.ts",
    "check:runtime-imports": "bun run scripts/check-runtime-imports.ts",
    "build:artifact": "bun run scripts/build-artifact.ts",
    "update:managed-tools": "bun run scripts/update-managed-tools.ts",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@coding-agent/ai": "workspace:*",
    "@types/bun": "^1.3.14",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "ink@7.1.1": "patches/ink@7.1.1.patch"
  }
}
