{
  "name": "coding-agent",
  "version": "0.0.1",
  "description": "Coding Agent CLI — natural-language coding tasks over a real codebase",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun run --filter '@coding-agent/*' build",
    "check": "biome check .",
    "ci:check": "biome ci .",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
