{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!**/dist", "!bun.lock"]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "off",
        "useImportType": "error",
        "noEnum": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ai/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/agent-core",
                      "@coding-agent/agent-core/**",
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from ai. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agent-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from agent-core. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/ai",
                      "@coding-agent/ai/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from tools. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/ai",
                      "@coding-agent/ai/**",
                      "@coding-agent/agent-core",
                      "@coding-agent/agent-core/**",
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from tui. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tui/prototype/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    }
  ]
}
