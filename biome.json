{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!**/dist", "!bun.lock"]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "off",
        "useImportType": "error",
        "noEnum": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ai/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/agent-core",
                      "@coding-agent/agent-core/**",
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from ai. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agent-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from agent-core. Wire collaborators through coding-agent instead."
                  },
                  {
                    "group": [
                      "node:*",
                      "node:*/**",
                      "fs",
                      "fs/**",
                      "child_process",
                      "net",
                      "http",
                      "http2",
                      "https",
                      "tls",
                      "dgram",
                      "dns",
                      "dns/**",
                      "readline",
                      "readline/**",
                      "tty",
                      "process",
                      "worker_threads",
                      "bun",
                      "bun:ffi",
                      "bun:sqlite"
                    ],
                    "message": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "process": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "console": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "fetch": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "WebSocket": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "XMLHttpRequest": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "EventSource": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "globalThis": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead.",
                  "require": "ADR 0004 §3: Agent Core performs no terminal, filesystem, or network I/O. Inject a port instead."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/ai",
                      "@coding-agent/ai/**",
                      "@coding-agent/tui",
                      "@coding-agent/tui/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from tools. Wire collaborators through coding-agent instead."
                  },
                  {
                    "group": [
                      "node:child_process",
                      "child_process",
                      "node:cluster",
                      "cluster",
                      "node:worker_threads",
                      "worker_threads",
                      "bun",
                      "bun:ffi"
                    ],
                    "message": "CDA-68: launch children through the configured ChildProcessLauncher; raw process APIs bypass credential filtering."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tools/src/**", "!packages/tools/src/child-process.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "CDA-68: only child-process.ts may use Bun to start a child; use the injected ChildProcessLauncher.",
                  "globalThis": "CDA-68: do not access raw process APIs through globalThis; use the injected ChildProcessLauncher.",
                  "self": "CDA-68: do not access raw process APIs through self; use the injected ChildProcessLauncher.",
                  "global": "CDA-68: do not access raw process APIs through global; use the injected ChildProcessLauncher.",
                  "require": "CDA-68: do not load raw process APIs through require; use the injected ChildProcessLauncher."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@coding-agent/ai",
                      "@coding-agent/ai/**",
                      "@coding-agent/agent-core",
                      "@coding-agent/agent-core/**",
                      "@coding-agent/tools",
                      "@coding-agent/tools/**",
                      "@coding-agent/coding-agent",
                      "@coding-agent/coding-agent/**"
                    ],
                    "message": "ADR 0004 §1 forbids this dependency from tui. Wire collaborators through coding-agent instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
