# API key you can use
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# OpenCode session id (Optional)
OPENCODE_SESSION_ID=

# Custom Provider example (Optional)
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL_ID=llama3
# CUSTOM_API_KEY=
# CUSTOM_API_KEY_ENV=

# Managed binaries (fd, rg) (Optional)
# Override the default OS cache root for downloaded binaries.
# CODING_AGENT_CACHE_DIR=
# Set to 1, true, or yes to skip downloading managed binaries (cache and PATH are still checked).
# CODING_AGENT_OFFLINE=
